# Python-generated files
__pycache__/
*.py[oc]
dist/
wheels/
*.egg-info

# Virtual environments and local variables
.venv
.env

# Local files
.DS_Store

# Generated content
bin/

# Sphinx's incremental-build pickle cache: opaque binary files with no
# documentation value, regenerated by `make docs`. The rendered HTML in
# docs/build/html/ (everything except this) is tracked.
docs/build/html/.doctrees/

# Sphinx's copy of every source page, byte-identical to docs/source/**.
# html_copy_source = False in conf.py stops this from being generated;
# this is a safety net in case that setting ever stops applying.
docs/build/html/_sources/