# Reports describe one working tree at one moment, so nothing is tracked by
# default. The pre-PR audit's written record is the one exception.
*
!.gitignore
!README.md
!pre-pr-audit-2026-10-10/
pre-pr-audit-2026-10-10/*
!pre-pr-audit-2026-10-10/report.md
!pre-pr-audit-2026-10-10/report.html
!pre-pr-audit-2026-10-10/validation.md
!pre-pr-audit-2026-10-10/deferred-risks.md
!pre-pr-audit-2026-10-10/manual-spot-checks.md
!pre-pr-audit-2026-10-10/run_manual_spot_check.py
!v5-feature-parity-audit.md
!v5-feature-parity-audit.html
!upstream-rest-update-body-merge.md
!kentik-api-team-findings.md
!upstream-openapi-python-generator-optional-formatters.md
!upstream-kptr-missing-http-annotations.html
!upstream-kptr-missing-http-annotations.md
!upstream-ratelimit-scope-undocumented.html
!upstream-ratelimit-scope-undocumented.md
!upstream-service-visibility-exposure.html
!upstream-service-visibility-exposure.md
!report-theme.css
!assets/
!assets/*.svg
!assets/*.js
!assets/*.css
!scripts/
!scripts/**
!archive/
archive/*
!archive/upstream-jira-drafts.md
!archive/upstream-rest-update-body-merge.html
!archive/upstream-alert-list-requirements.html
!archive/upstream-alert-list-requirements.md
